{
  "name": "lokey-editor-core",
  "version": "0.0.0",
  "description": "Core library of the Lokey Editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nn1ks/lokey.git",
    "directory": "editor/lokey-editor-core"
  },
  "homepage": "https://github.com/nn1ks/lokey#readme",
  "bugs": {
    "url": "https://github.com/nn1ks/lokey/issues"
  },
  "files": [
    "dist"
  ],
  "private": false,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index/index.js",
  "module": "./dist/index/index.js",
  "types": "./dist/index/index.d.ts",
  "browser": {},
  "exports": {
    ".": {
      "development": {
        "import": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/dev.js"
        }
      },
      "import": {
        "types": "./dist/index/index.d.ts",
        "default": "./dist/index/index.js"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.js"
      }
    },
    "./components/keymap": {
      "import": {
        "types": "./dist/components/keymap/index.d.ts",
        "default": "./dist/components/keymap/index.js"
      }
    },
    "./components/led-array": {
      "import": {
        "types": "./dist/components/led-array/index.d.ts",
        "default": "./dist/components/led-array/index.js"
      }
    },
    "./components/start": {
      "import": {
        "types": "./dist/components/start/index.d.ts",
        "default": "./dist/components/start/index.js"
      }
    },
    "./contexts": {
      "import": {
        "types": "./dist/contexts/index.d.ts",
        "default": "./dist/contexts/index.js"
      }
    },
    "./protocol": {
      "import": {
        "types": "./dist/protocol/index.d.ts",
        "default": "./dist/protocol/index.js"
      }
    },
    "./styles.css": "./src/styles/global.css"
  },
  "typesVersions": {
    "*": {
      "components": [
        "./dist/components/index.d.ts"
      ],
      "components/keymap": [
        "./dist/components/keymap/index.d.ts"
      ],
      "components/led-array": [
        "./dist/components/led-array/index.d.ts"
      ],
      "components/start": [
        "./dist/components/start/index.d.ts"
      ],
      "contexts": [
        "./dist/contexts/index.d.ts"
      ],
      "protocol": [
        "./dist/protocol/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "vite serve dev",
    "build": "tsup",
    "test": "concurrently pnpm:test:*",
    "test:client": "vitest",
    "test:ssr": "pnpm run test:client --mode ssr",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "format": "prettier --ignore-path .gitignore -w \"src/**/*.{js,ts,json,css,tsx,jsx}\" \"dev/**/*.{js,ts,json,css,tsx,jsx}\"",
    "lint": "concurrently pnpm:lint:*",
    "lint:code": "eslint --ignore-path .gitignore --max-warnings 0 src/**/*.{js,ts,tsx,jsx}",
    "lint:types": "tsc --noEmit",
    "update-deps": "pnpm up -Li"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.3",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^8.56.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "jsdom": "^24.0.0",
    "prettier": "3.0.0",
    "solid-js": "^1.8.17",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.2",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "solid"
  ],
  "dependencies": {
    "@ark-ui/solid": "^5.39.1",
    "capnp-es": "^0.0.16",
    "lokey-editor-odyn": "workspace:*",
    "lucide-solid": "^1.45.0"
  }
}
