{
  "name": "lokey-editor-odyn",
  "version": "0.0.0",
  "description": "Cap'n Proto bindings for the Odyn protocol used by the Lokey Editor",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nn1ks/lokey.git",
    "directory": "editor/lokey-editor-odyn"
  },
  "exports": {
    "./core": {
      "types": "./src/core.ts",
      "import": "./src/core.ts"
    },
    "./core/message-id": {
      "types": "./src/core/message-id.ts",
      "import": "./src/core/message-id.ts"
    },
    "./core/device-id": {
      "types": "./src/core/device-id.ts",
      "import": "./src/core/device-id.ts"
    }
  },
  "scripts": {
    "generate": "capnp-es ../../crates/lokey-odyn/schema/*.capnp --src-prefix=../../crates/lokey-odyn/schema -ojs,dts:src/generated",
    "build": "pnpm run generate && tsc",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc"
  },
  "dependencies": {
    "capnp-es": "^0.0.16"
  },
  "devDependencies": {
    "typedoc": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
